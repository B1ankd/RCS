// Function to set up all triggers automatically
function setupAllTriggers() {
  // Delete existing triggers to avoid duplicates
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(trigger => {
    const handlerFunction = trigger.getHandlerFunction();
    if (handlerFunction === 'refreshLeadColors' || 
        handlerFunction === 'onEdit' || 
        handlerFunction === 'onChange') {
      ScriptApp.deleteTrigger(trigger);
    }
  });
  
  // Set up time-based trigger for color refresh (every minute)
  ScriptApp.newTrigger('refreshLeadColors')
    .timeBased()
    .everyMinutes(1)
    .create();
  
  // Set up onEdit trigger
  ScriptApp.newTrigger('onEdit')
    .forSpreadsheet(SPREADSHEET_ID)
    .onEdit()
    .create();
  
  // Set up onChange trigger for row deletions
  ScriptApp.newTrigger('onChange')
    .forSpreadsheet(SPREADSHEET_ID)
    .onChange()
    .create();
  
  console.log('All triggers set up successfully!');
}

// Manual function to initialize colors and sorting for existing data
function initializeLeadManagement() {
  sortAndColorCodeLeads();
  setupAllTriggers();
  console.log('Lead management initialized! Colors will refresh every minute.');
}

