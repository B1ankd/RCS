// Sort and color functions (unchanged from original)
function sortAndColorCodeLeads() {
  try {
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
    
    const lastRow = sheet.getLastRow();
    if (lastRow <= 1) return; 
    
    const lastCol = sheet.getLastColumn();
    const dataRange = sheet.getRange(2, 1, lastRow - 1, lastCol);
    const data = dataRange.getValues();
    
    data.sort((a, b) => {
      const dateA = new Date(a[0]);
      const dateB = new Date(b[0]);
      return dateB - dateA; 
    });
    
    dataRange.setValues(data);
    applyColorCoding(sheet);
  } catch (error) {
    console.error('Error in sortAndColorCodeLeads:', error);
  }
}

function applyColorCoding(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow <= 1) return; 
  
  const now = new Date();
  const timestampRange = sheet.getRange(2, 1, lastRow - 1, 1); 
  const timestamps = timestampRange.getValues();
  const backgrounds = [];
  
  timestamps.forEach(([timestamp]) => {
    if (!timestamp || timestamp === '') {
      backgrounds.push([null]); 
      return;
    }
    
    const leadTime = new Date(timestamp);
    const ageInMinutes = (now - leadTime) / (1000 * 60);
    
    let color;
    if (ageInMinutes <= 10) {
      color = LEAD_COLORS.NEW;
    } else if (ageInMinutes <= 30) {
      color = LEAD_COLORS.RECENT;
    } else if (ageInMinutes <= 60) {
      color = LEAD_COLORS.MODERATE;
    } else {
      color = LEAD_COLORS.OLD;
    }
    
    backgrounds.push([color]);
  });
  
  timestampRange.setBackgrounds(backgrounds);
  cleanupEmptyRows();
}

function refreshLeadColors() {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
  applyColorCoding(sheet);
}

function onEdit(e) {
  if (!e || !e.source) return;
  
  const sheet = e.source.getActiveSheet();
  if (sheet.getName() !== SHEET_NAME) return;
  
  const row = e.range.getRow();
  if (row < 2) return;
  
  const col = e.range.getColumn();
  if (col === 1 && (e.value === '' || e.value === null || e.value === undefined)) {
    e.range.setBackground(null);
  }
  
  const lastCol = sheet.getLastColumn();
  const rowData = sheet.getRange(row, 1, 1, lastCol).getValues()[0];
  const isRowEmpty = rowData.every(cell => cell === '' || cell === null);
  
  if (isRowEmpty) {
    sheet.getRange(row, 1, 1, lastCol).setBackground(null);
  } else {
    sortAndColorCodeLeads();
  }
}

function onChange(e) {
  try {
    sortAndColorCodeLeads();
  } catch (error) {
    console.error('Error in onChange:', error);
  }
}

function cleanupEmptyRows() {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
  const lastRow = sheet.getLastRow();
  const maxRows = sheet.getMaxRows();
  
  if (lastRow < maxRows) {
    const emptyRange = sheet.getRange(lastRow + 1, 1, maxRows - lastRow, 1);
    emptyRange.setBackground(null);
  }
  
  if (lastRow > 1) {
    const dataRange = sheet.getRange(2, 1, lastRow - 1, 1);
    const values = dataRange.getValues();
    const backgrounds = dataRange.getBackgrounds();
    
    for (let i = 0; i < values.length; i++) {
      if (values[i][0] === '' || values[i][0] === null) {
        backgrounds[i][0] = null;
      }
    }
    
    dataRange.setBackgrounds(backgrounds);
  }
}

function setupAllTriggers() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(trigger => {
    const handlerFunction = trigger.getHandlerFunction();
    if (handlerFunction === 'refreshLeadColors' || 
        handlerFunction === 'onEdit' || 
        handlerFunction === 'onChange') {
      ScriptApp.deleteTrigger(trigger);
    }
  });
  
  ScriptApp.newTrigger('refreshLeadColors')
    .timeBased()
    .everyMinutes(1)
    .create();
  
  ScriptApp.newTrigger('onEdit')
    .forSpreadsheet(SPREADSHEET_ID)
    .onEdit()
    .create();
  
  ScriptApp.newTrigger('onChange')
    .forSpreadsheet(SPREADSHEET_ID)
    .onChange()
    .create();
  
  console.log('All triggers set up successfully!');
}

function initializeLeadManagement() {
  sortAndColorCodeLeads();
  setupAllTriggers();
  console.log('Lead management initialized! Colors will refresh every minute.');
}

