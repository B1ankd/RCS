// Color configuration for lead age
const LEAD_COLORS = {
  NEW: '#00ff00',        // Green - 10 mins or newer
  RECENT: '#00ffff',     // Cyan - 10-30 mins
  MODERATE: '#ff00ff',   // Magenta - 30-60 mins
  OLD: '#dc143c'         // Red berry - 60+ mins
};

// Web App entry point - handles POST requests
function doPost(e) {
  try {
    // Parse the JSON data from the request
    const data = JSON.parse(e.postData.contents);
    
    // Enhanced debug logging to understand form types
    console.log('=== ENHANCED FORM SUBMISSION DEBUG ===');
    console.log('Raw postData:', e.postData.contents);
    console.log('Parsed form data:', JSON.stringify(data, null, 2));
    
    // Multiple checks to identify qualification forms
    const hasQualificationQuestions = data.q1_entrances !== undefined && data.q2_badges !== undefined;
    const hasRiskData = data.riskPercentage !== undefined && data.totalScore !== undefined;
    const hasFormTypeFlag = data.formType === 'Security Qualification Survey';
    const hasVulnerabilities = data.vulnerabilities !== undefined;
    
    const isQualificationForm = hasQualificationQuestions || hasRiskData || hasFormTypeFlag || hasVulnerabilities;
    
    console.log('=== FORM TYPE DETECTION ===');
    console.log('Has qualification questions:', hasQualificationQuestions);
    console.log('Has risk data:', hasRiskData);
    console.log('Has formType flag:', hasFormTypeFlag);
    console.log('Has vulnerabilities:', hasVulnerabilities);
    console.log('Final determination - Is Qualification Form:', isQualificationForm);
    console.log('=== END DEBUG ===');
    
    // Mark the data with form type to ensure it's passed along
    if (isQualificationForm) {
      data.formType = 'Security Qualification Survey';
    } else {
      data.formType = 'Contact Form';
    }
    
    // Save to spreadsheet
    saveToSpreadsheet(data);
    
    // Sort and color code leads
    sortAndColorCodeLeads();
    
    // Send appropriate confirmation emails
    if (isQualificationForm) {
      console.log('Sending qualification confirmation email to:', data.email);
      sendQualificationConfirmationEmail(data.email, data);
    } else {
      console.log('Sending contact form confirmation email to:', data.email);
      sendContactFormConfirmationEmail(data.email, data);
      
      // Send to business email if different
      if (data.businessEmail && data.businessEmail !== data.email) {
        sendContactFormConfirmationEmail(data.businessEmail, data);
      }
    }
    
    // Send notification email to management
    sendNotificationEmail(data);
    
    return ContentService
      .createTextOutput(JSON.stringify({status: 'success', message: 'Form submitted successfully'}))
      .setMimeType(ContentService.MimeType.JSON);
      
  } catch (error) {
    console.error('Error processing form:', error);
    return ContentService
      .createTextOutput(JSON.stringify({status: 'error', message: error.toString()}))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// Save form data to Google Sheets
function saveToSpreadsheet(data) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
  const isQualificationForm = data.formType === 'Security Qualification Survey';
  
  // If this is the first entry, add headers
  if (sheet.getLastRow() === 0) {
    const headers = [
      'Timestamp',
      'Form Type',
      'First Name',
      'Last Name',
      'Phone',
      'Email',
      'Company Name',
      'Business Email',
      'Street Address',
      'City',
      'State',
      'Country',
      'Zip',
      'Business Description',
      'Employees',
      'Services',
      'Risk Score %',
      'Risk Level',
      'Vulnerabilities',
      'Q1: Entrances',
      'Q2: Badges',
      'Q3: Termination',
      'Q4: Server Room',
      'Q5: Uniforms',
      'Q6: Strangers',
      'Q7: Visitors',
      'Q8: Sensitive Areas',
      'Q9: Packages',
      'Q10: Incidents'
    ];
    sheet.appendRow(headers);
  }
  
  // Prepare row data
  const row = [
    new Date(), // Timestamp
    data.formType || 'Contact Form',
    data.firstName || '',
    data.lastName || '',
    data.phone || data.phoneNumber || '',
    data.email || '',
    data.companyName || '',
    data.businessEmail || '',
    data.streetAddress || '',
    data.city || '',
    data.state || '',
    data.country || '',
    data.zip || '',
    data.businessJourney || '',
    data.employees || '',
    data.services ? data.services.join(', ') : '',
    // Qualification-specific data
    data.riskPercentage || '',
    data.riskLevel || '',
    data.vulnerabilities || '',
    data.q1_entrances || '',
    data.q2_badges || '',
    data.q3_termination || '',
    data.q4_serverRoom || '',
    data.q5_uniforms || '',
    data.q6_strangers || '',
    data.q7_visitors || '',
    data.q8_sensitiveAreas || '',
    data.q9_packages || '',
    data.q10_incidents || ''
  ];
  
  sheet.appendRow(row);
}

