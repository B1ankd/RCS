function doPost(e) {
  try {
    console.log('=== DEBUG TEST - RAW REQUEST ===');
    console.log('Request received at:', new Date().toISOString());
    console.log('Raw postData:', e.postData ? e.postData.contents : 'NO POST DATA');
    
    if (!e.postData || !e.postData.contents) {
      console.error('No POST data received');
      return ContentService.createTextOutput('No data received').setMimeType(ContentService.MimeType.TEXT);
    }
    
    const data = JSON.parse(e.postData.contents);
    console.log('Parsed data keys:', Object.keys(data));
    console.log('Form type:', data.formType);
    console.log('Has q1_entrances:', !!data.q1_entrances);
    console.log('Has riskPercentage:', !!data.riskPercentage);
    
    // Force qualification form detection for testing
    const isQualificationForm = data.formType === 'Security Qualification Survey' || 
                                data.q1_entrances !== undefined || 
                                data.riskPercentage !== undefined;
    
    console.log('Qualification form detected:', isQualificationForm);
    
    if (isQualificationForm) {
      console.log('=== QUALIFICATION FORM DATA ===');
      console.log('Contact info:', {
        firstName: data.firstName,
        lastName: data.lastName,
        email: data.email,
        companyName: data.companyName,
        phoneNumber: data.phoneNumber
      });
      
      console.log('Assessment data:', {
        riskPercentage: data.riskPercentage,
        riskLevel: data.riskLevel,
        totalScore: data.totalScore,
        vulnerabilities: data.vulnerabilities
      });
      
      console.log('Question responses:', {
        q1_entrances: data.q1_entrances,
        q2_badges: data.q2_badges,
        q3_termination: data.q3_termination,
        q4_serverRoom: data.q4_serverRoom,
        q5_uniforms: data.q5_uniforms,
        q6_strangers: data.q6_strangers,
        q7_visitors: data.q7_visitors,
        q8_sensitiveAreas: data.q8_sensitiveAreas,
        q9_packages: data.q9_packages,
        q10_incidents: data.q10_incidents
      });
      
      // Test sending qualification email
      console.log('Attempting to send qualification email to:', data.email);
      sendTestQualificationEmail(data.email, data);
      
    } else {
      console.log('=== CONTACT FORM DATA ===');
      console.log('Standard contact form detected');
      sendTestContactEmail(data.email, data);
    }
    
    // Always send notification to management
    sendTestNotificationEmail(data);
    
    return ContentService
      .createTextOutput(JSON.stringify({
        status: 'success', 
        message: 'Debug test completed',
        isQualification: isQualificationForm
      }))
      .setMimeType(ContentService.MimeType.JSON);
      
  } catch (error) {
    console.error('=== ERROR IN DEBUG TEST ===');
    console.error('Error message:', error.message);
    console.error('Error stack:', error.stack);
    
    return ContentService
      .createTextOutput(JSON.stringify({
        status: 'error', 
        message: error.toString(),
        stack: error.stack
      }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

