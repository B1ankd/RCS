                if (qa.score < 3) return '';
                
                const vulnerabilityMessages = {
                  0: "Multiple unmonitored entry points",
                  1: "Weak badge replacement procedures", 
                  2: "Delayed access termination process",
                  3: "Excessive server room access",
                  4: "Uniform-based access vulnerability",
                  5: "Poor stranger challenging culture",
                  6: "Unsecured visitor management",
                  7: "Inadequate sensitive area protection",
                  8: "Unscreened package delivery process",
                  9: "Unknown security incident history"
                };
                
                const vulnerability = vulnerabilityMessages[index] || "Security vulnerability identified";
                
                return `<li style="padding: 8px 0; padding-left: 15px; position: relative;">
                  <span style="position: absolute; left: 0; top: 50%; transform: translateY(-50%); color: #970c1c; font-size: 16px; font-weight: bold;">•</span>
                  ${vulnerability}
                </li>`;
              })
              .filter(item => item !== '')
              .join('')}
          </ul>
        </div>
        ` : ''}

        <div class="questions-section">
          <h3>Detailed Assessment Results</h3>
          ${data.questionsAnswered && Array.isArray(data.questionsAnswered) ? 
            data.questionsAnswered.map((qa, index) => {
              let scoreClass = 'score-low';
              if (qa.score >= 3) scoreClass = 'score-high';
              else if (qa.score >= 2) scoreClass = 'score-medium';
              
              return `
                <div class="question-item">
                  <div class="score-badge ${scoreClass}">Score: ${qa.score}/4</div>
                  <div class="question-text">Q${index + 1}: ${qa.question}</div>
                  <div class="answer-text">Answer: ${qa.answer}</div>
                </div>
              `;
            }).join('') : 
            '<p>No assessment data available</p>'
          }
        </div>
      </div>
      
      <div class="footer">
        <a href="https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}" class="action-button">View in Spreadsheet</a>
        <a href="mailto:${data.email}" class="action-button">Contact Lead</a>
      </div>
    </div>
  </div>
</body>
</html>
  `;
  
  // Send the notification email to management
  GmailApp.sendEmail(
    MANAGEMENT_EMAIL,
    subject,
    '', // Plain text body (empty since we're using HTML)
    {
      htmlBody: htmlBody,
      name: 'RCS Qualification System',
      from: SENDER_EMAIL
    }
  );
}

