// Simple test to verify spreadsheet access
function testSpreadsheetAccess() {
  try {
    console.log('Testing spreadsheet access...');
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    console.log('Spreadsheet opened successfully:', spreadsheet.getName());
    
    const sheet = spreadsheet.getSheetByName(SHEET_NAME);
    if (!sheet) {
      console.error('Sheet not found:', SHEET_NAME);
      return 'Sheet not found: ' + SHEET_NAME + '. Make sure Sheet1 exists in your spreadsheet.';
    }
    console.log('Sheet accessed successfully:', sheet.getName());
    
    console.log('Sheet has', sheet.getLastRow(), 'rows');
    
    return 'Spreadsheet access test passed! Sheet found with ' + sheet.getLastRow() + ' rows.';
  } catch (error) {
    console.error('Spreadsheet access test failed:', error);
    return 'Spreadsheet access test failed: ' + error.toString();
  }
}

// Function to refresh colors (called by time-based trigger)
function refreshLeadColors() {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
  if (sheet) {
    applyColorCoding(sheet);
  }
}

// Function to set up triggers for the qualification sheet
function setupQualificationTriggers() {
  // Delete existing triggers to avoid duplicates
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(trigger => {
    const handlerFunction = trigger.getHandlerFunction();
    if (handlerFunction === 'refreshLeadColors') {
      ScriptApp.deleteTrigger(trigger);
    }
  });
  
  // Set up time-based trigger for color refresh (every minute)
  ScriptApp.newTrigger('refreshLeadColors')
    .timeBased()
    .everyMinutes(1)
    .create();
  
  console.log('Qualification form triggers set up successfully!');
}

// Manual function to initialize the qualification system
function initializeQualificationSystem() {
  try {
    // Verify the sheet exists (should be same as contact form)
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(SHEET_NAME);
    if (!sheet) {
      console.error('Sheet not found:', SHEET_NAME);
      console.log('Make sure your Google Sheet has a tab named "' + SHEET_NAME + '"');
      return 'Error: Sheet not found. Make sure Sheet1 exists in your spreadsheet.';
    }
    
    console.log('Using existing sheet:', sheet.getName(), 'with', sheet.getLastRow(), 'rows');
    
    sortAndColorCodeLeads();
    setupQualificationTriggers();
    console.log('Qualification system initialized successfully!');
    return 'Qualification system initialized successfully! Using sheet: ' + sheet.getName();
  } catch (error) {
    console.error('Error initializing qualification system:', error);
    return 'Error: ' + error.toString();
  }
}

