// Google Apps Script for RCS Qualification Form
// This script handles qualification form submissions, saves to Google Sheets, and sends emails

// Configuration - IMPORTANT: Update these values for your setup
const SPREADSHEET_ID = '1PxscgTQUlz-UVLHHEaeoWBeDxknDjteMyfid0Oie_N4'; // Use same spreadsheet as contact form
const SHEET_NAME = 'Sheet1'; // Use same sheet as contact form
const SENDER_EMAIL = 'no-reply@redcellsolutions.com';
const MANAGEMENT_EMAIL = 'mgmt.rcs@gmail.com'; // As requested

// Document attachment configuration
const STATIC_PDF_FILE_ID = '1Lq2LTlkGi5kd1Ry5f96GSLsZTynC5mNH'; // Your security analysis PDF
const DOCUMENT_FOLDER_ID = ''; // Optional: Google Drive folder ID where documents are stored
const SECURITY_ANALYSIS_DOC_ID = ''; // Optional: Template document ID to copy and customize

// Color configuration for lead age
const LEAD_COLORS = {
  NEW: '#00ff00',        // Green - 10 mins or newer
  RECENT: '#00ffff',     // Cyan - 10-30 mins
  MODERATE: '#ff00ff',   // Magenta - 30-60 mins
  OLD: '#dc143c'         // Red berry - 60+ mins
};

// Web App entry point - handles POST requests
function doPost(e) {
  try {
    console.log('Received request:', e);
    
    // Check if we have postData
    if (!e || !e.postData) {
      console.error('No postData received');
      return ContentService
        .createTextOutput(JSON.stringify({status: 'error', message: 'No data received'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    
    console.log('Raw postData:', e.postData.contents);
    
    // Parse the JSON data from the request
    const data = JSON.parse(e.postData.contents);
    console.log('Parsed data:', data);
    
    // Validate required fields
    if (!data.firstName || !data.lastName || !data.email || !data.companyName) {
      console.error('Missing required fields:', data);
      return ContentService
        .createTextOutput(JSON.stringify({status: 'error', message: 'Missing required fields'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    
    // Save to spreadsheet
    console.log('Saving to spreadsheet...');
    saveToSpreadsheet(data);
    
    // Sort and color code leads
    console.log('Sorting and color coding...');
    sortAndColorCodeLeads();
    
    // Send confirmation email to the user
    console.log('Sending user email...');
    sendUserConfirmationEmail(data.email, data);
    
    // Send notification email to management
    console.log('Sending management email...');
    sendManagementNotificationEmail(data);
    
    console.log('All operations completed successfully');
    
    // Return success response
    return ContentService
      .createTextOutput(JSON.stringify({status: 'success', message: 'Qualification form submitted successfully'}))
      .setMimeType(ContentService.MimeType.JSON);
      
  } catch (error) {
    console.error('Error processing qualification form:', error);
    console.error('Error stack:', error.stack);
    return ContentService
      .createTextOutput(JSON.stringify({status: 'error', message: error.toString()}))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// Save form data to Google Sheets - using same format as contact form
function saveToSpreadsheet(data) {
  try {
    console.log('Opening spreadsheet with ID:', SPREADSHEET_ID);
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
    
    if (!sheet) {
      console.error('Sheet not found:', SHEET_NAME);
      throw new Error('Sheet not found: ' + SHEET_NAME);
    }
    
    console.log('Sheet found:', SHEET_NAME);
    
    // Check if headers exist (same format as contact form)
    if (sheet.getLastRow() === 0) {
      console.log('Adding headers to match contact form format');
      const headers = [
        'Timestamp',
        'First Name',
        'Last Name',
        'Phone',
        'Email',
        'Company Name',
        'Business Email',
        'Street Address',
        'City',
        'State',
        'Country',
        'Zip',
        'Business Description',
        'Employees',
        'Services'
      ];
      sheet.appendRow(headers);
    }
    
    // Prepare qualification data in simplified contact form format
    console.log('Preparing simplified qualification data for:', data.firstName, data.lastName);
    
    // Prepare row data with only essential information - leave other fields blank
    const row = [
      new Date(), // Timestamp
      data.firstName || '',
      data.lastName || '',
      data.phone || '',
      data.email || '', // Personal email
      data.companyName || '',
      data.email || '', // Business email (same as personal for qualification)
      '', // Street Address - BLANK
      '', // City - BLANK
      '', // State - BLANK
      '', // Country - BLANK
      '', // Zip - BLANK
      '', // Business Description - BLANK
      '', // Employees - BLANK
      '' // Services - BLANK
    ];
    
    // Append the row
    console.log('Appending qualification row to contact sheet:', row);
    sheet.appendRow(row);
    console.log('Qualification data saved successfully to contact sheet');
    
  } catch (error) {
    console.error('Error in saveToSpreadsheet:', error);
    throw error; // Re-throw to be caught by doPost
  }
}

// Sort leads by timestamp (newest first) and apply color coding
function sortAndColorCodeLeads() {
  try {
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
    if (!sheet) return;
    
    // Get all data (excluding header row)
    const lastRow = sheet.getLastRow();
    if (lastRow <= 1) return; // No data to sort
    
    const lastCol = sheet.getLastColumn();
    const dataRange = sheet.getRange(2, 1, lastRow - 1, lastCol);
    const data = dataRange.getValues();
    
    // Sort data by timestamp (column A, index 0) in descending order
    data.sort((a, b) => {
      const dateA = new Date(a[0]);
      const dateB = new Date(b[0]);
      return dateB - dateA; // Newest first
    });
    
    // Write sorted data back to sheet
    dataRange.setValues(data);
    
    // Apply color coding
    applyColorCoding(sheet);
  } catch (error) {
    console.error('Error in sortAndColorCodeLeads:', error);
  }
}

// Apply color coding based on lead age
function applyColorCoding(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow <= 1) return; // No data to color
  
  const now = new Date();
  const timestampRange = sheet.getRange(2, 1, lastRow - 1, 1); // Column A only
  const timestamps = timestampRange.getValues();
  const backgrounds = [];
  
  timestamps.forEach(([timestamp]) => {
    if (!timestamp || timestamp === '') {
      backgrounds.push([null]); // No color for empty cells
      return;
    }
    
    const leadTime = new Date(timestamp);
    const ageInMinutes = (now - leadTime) / (1000 * 60);
    
    let color;
    if (ageInMinutes <= 10) {
      color = LEAD_COLORS.NEW;
    } else if (ageInMinutes <= 30) {
      color = LEAD_COLORS.RECENT;
    } else if (ageInMinutes <= 60) {
      color = LEAD_COLORS.MODERATE;
    } else {
      color = LEAD_COLORS.OLD;
    }
    
    backgrounds.push([color]);
  });
  
  timestampRange.setBackgrounds(backgrounds);
}

// Function to get or create the security analysis document
function getSecurityAnalysisDocument(data) {
  try {
    // Method 1: Use a static PDF file from Google Drive
    if (STATIC_PDF_FILE_ID) {
      const file = DriveApp.getFileById(STATIC_PDF_FILE_ID);
      const blob = file.getBlob();
      // Optionally rename the file for the attachment
      blob.setName('RCS_Security_Analysis.pdf');
      return blob;
    }
    
    // Method 2: Create a personalized Google Doc and convert to PDF
    if (SECURITY_ANALYSIS_DOC_ID) {
      // Make a copy of the template document
      const templateDoc = DriveApp.getFileById(SECURITY_ANALYSIS_DOC_ID);
      const docName = `Security Analysis - ${data.companyName} - ${new Date().toLocaleDateString()}`;
      const docCopy = templateDoc.makeCopy(docName);
      
      // Open the document and replace placeholders
      const doc = DocumentApp.openById(docCopy.getId());
      const body = doc.getBody();
      
      // Replace placeholders with actual data
      body.replaceText('{{firstName}}', data.firstName);
      body.replaceText('{{lastName}}', data.lastName);
      body.replaceText('{{companyName}}', data.companyName);
      body.replaceText('{{riskScore}}', data.totalRiskScore + '%');
      body.replaceText('{{date}}', new Date().toLocaleDateString());
      
      // Save and close the document
      doc.saveAndClose();
      
      // Convert to PDF
      const pdfBlob = docCopy.getAs('application/pdf');
      pdfBlob.setName(`Security_Analysis_${data.companyName.replace(/\s+/g, '_')}.pdf`);
      
      // Optionally move to a specific folder
      if (DOCUMENT_FOLDER_ID) {
        const folder = DriveApp.getFolderById(DOCUMENT_FOLDER_ID);
        folder.addFile(docCopy);
      }
      
      // Delete the temporary Google Doc after creating PDF
      DriveApp.removeFile(docCopy);
      
      return pdfBlob;
    }
    
    // Method 3: Create a simple PDF with security analysis summary
    // This creates a basic text-based PDF without needing a template
    const content = `
SECURITY ANALYSIS REPORT
========================

Company: ${data.companyName}
Contact: ${data.firstName} ${data.lastName}
Date: ${new Date().toLocaleDateString()}

RISK ASSESSMENT SUMMARY
----------------------
Overall Risk Score: ${data.totalRiskScore}%
Risk Level: ${data.totalRiskScore >= 75 ? 'CRITICAL' : data.totalRiskScore >= 50 ? 'HIGH' : data.totalRiskScore >= 25 ? 'MODERATE' : 'LOW'}

KEY FINDINGS
-----------
${data.questionsAnswered && Array.isArray(data.questionsAnswered) ? 
  data.questionsAnswered
    .filter(qa => qa.score >= 3)
    .map((qa, index) => `• ${qa.question}\n  Answer: ${qa.answer} (Risk Score: ${qa.score}/4)`)
    .join('\n\n') : 
  'No critical vulnerabilities identified.'}

RECOMMENDATIONS
--------------
Based on your security assessment, we recommend:
1. Schedule a comprehensive security audit
2. Implement immediate fixes for critical vulnerabilities
3. Develop a security improvement roadmap
4. Train staff on security best practices

NEXT STEPS
----------
A security consultant will contact you within 24 hours to discuss:
- Detailed vulnerability analysis
- Customized security solutions
- Implementation timeline
- Investment requirements

This analysis is valued at $2,500 and is provided free of charge.

For immediate assistance, contact:
RCS Security
Email: ${MANAGEMENT_EMAIL}
Web: https://redcellsolutions.com
`;
    
    // Create a blob from the text content
    const blob = Utilities.newBlob(content, 'text/plain', `Security_Analysis_${data.companyName.replace(/\s+/g, '_')}.txt`);
    return blob;
    
  } catch (error) {
    console.error('Error creating document attachment:', error);
    return null; // Return null if attachment creation fails
  }
}

