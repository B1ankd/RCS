// Send qualification notification email to management (compact format)
function sendQualificationManagementEmail(data) {
  const risk = getQualificationRiskInfo(data.securityScore);
  const vulnerabilities = getVulnerabilities(data.questionsAnswered);
  const subject = `New Qualification Lead - ${data.companyName} (${data.securityScore}% - ${risk.level})`;

  // Build category scorecard HTML
  let categoryHtml = '';
  if (data.categoryScores && typeof data.categoryScores === 'object') {
    const categories = Object.keys(data.categoryScores);
    categoryHtml = `
        <div style="margin: 25px 0;">
          <h3 style="margin: 0 0 12px 0; font-size: 16px; color: #171717;">Category Breakdown</h3>
          <table style="width: 100%; border-collapse: collapse;">
            ${categories.map(cat => {
              const score = data.categoryScores[cat];
              let barColor = '#970c1c';
              if (score > 80) barColor = '#28a745';
              else if (score > 60) barColor = '#ffc107';
              return `
              <tr>
                <td style="padding: 6px 8px; font-size: 13px; color: #393939; width: 40%; border-bottom: 1px solid #f0f0f0;">${cat}</td>
                <td style="padding: 6px 8px; border-bottom: 1px solid #f0f0f0;">
                  <div style="background-color: #e9ecef; border-radius: 4px; height: 18px; width: 100%; position: relative;">
                    <div style="background-color: ${barColor}; border-radius: 4px; height: 18px; width: ${score}%;"></div>
                  </div>
                </td>
                <td style="padding: 6px 8px; font-size: 13px; font-weight: bold; color: ${barColor}; width: 50px; text-align: right; border-bottom: 1px solid #f0f0f0;">${score}%</td>
              </tr>`;
            }).join('')}
          </table>
        </div>`;
  }

  // Build vulnerabilities HTML
  let vulnHtml = '';
  if (vulnerabilities.length > 0) {
    vulnHtml = `
        <div style="background-color: #f4f4f4; padding: 20px; margin: 20px 0; border-radius: 8px; border-left: 4px solid #970c1c;">
          <h3 style="margin: 0 0 12px 0; font-size: 16px; color: #171717;">Critical Vulnerabilities</h3>
          <ul style="margin: 0; padding-left: 20px; list-style: none;">
            ${vulnerabilities.map(v => `
              <li style="padding: 4px 0; padding-left: 15px; position: relative; font-size: 13px;">
                <span style="position: absolute; left: 0; color: #970c1c; font-weight: bold;">&bull;</span>
                ${v}
              </li>
            `).join('')}
          </ul>
        </div>`;
  }

  // Build compact questions table - sorted worst first
  let questionsHtml = '';
  if (data.questionsAnswered && Array.isArray(data.questionsAnswered)) {
    const scoredQuestions = data.questionsAnswered
      .filter(qa => qa.scored)
      .sort((a, b) => a.points - b.points);

    questionsHtml = `
        <div style="margin-top: 25px;">
          <h3 style="margin: 0 0 12px 0; font-size: 16px; color: #171717;">Assessment Details (Sorted by Risk)</h3>
          <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
            <tr style="background-color: #171717; color: #ffffff;">
              <th style="padding: 8px 6px; text-align: left; font-weight: 600;">Q#</th>
              <th style="padding: 8px 6px; text-align: left; font-weight: 600;">Question</th>
              <th style="padding: 8px 6px; text-align: left; font-weight: 600;">Answer</th>
              <th style="padding: 8px 6px; text-align: center; font-weight: 600;">Score</th>
            </tr>
            ${scoredQuestions.map((qa, i) => {
              let badgeBg = '#28a745';
              let badgeText = '#ffffff';
              if (qa.points <= 4) { badgeBg = '#970c1c'; badgeText = '#ffffff'; }
              else if (qa.points <= 7) { badgeBg = '#ffc107'; badgeText = '#000000'; }
              const rowBg = i % 2 === 0 ? '#ffffff' : '#f9f9f9';
              // Truncate long answers
              const answer = (qa.answer || '').length > 50 ? qa.answer.substring(0, 47) + '...' : (qa.answer || '');
              const question = (qa.question || '').length > 60 ? qa.question.substring(0, 57) + '...' : (qa.question || '');
              return `
              <tr style="background-color: ${rowBg};">
                <td style="padding: 6px; border-bottom: 1px solid #f0f0f0; color: #666;">Q${qa.questionId}</td>
                <td style="padding: 6px; border-bottom: 1px solid #f0f0f0; color: #393939;">${question}</td>
                <td style="padding: 6px; border-bottom: 1px solid #f0f0f0; color: #171717;">${answer}</td>
                <td style="padding: 6px; border-bottom: 1px solid #f0f0f0; text-align: center;">
                  <span style="display: inline-block; background-color: ${badgeBg}; color: ${badgeText}; padding: 2px 8px; border-radius: 3px; font-weight: bold; font-size: 11px;">${qa.points}/10</span>
                </td>
              </tr>`;
            }).join('')}
          </table>
        </div>`;
  }

  // Build non-scored org profile answers
  let orgProfileHtml = '';
  if (data.questionsAnswered && Array.isArray(data.questionsAnswered)) {
    const nonScored = data.questionsAnswered.filter(qa => !qa.scored);
    if (nonScored.length > 0) {
      orgProfileHtml = `
        <div style="margin-top: 20px;">
          <h3 style="margin: 0 0 12px 0; font-size: 16px; color: #171717;">Organization Profile</h3>
          <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
            ${nonScored.map(qa => `
              <tr>
                <td style="padding: 6px 8px; font-weight: 600; color: #393939; width: 40%; border-bottom: 1px solid #f0f0f0;">${qa.question}</td>
                <td style="padding: 6px 8px; color: #171717; border-bottom: 1px solid #f0f0f0;">${qa.answer || '<em>Not provided</em>'}</td>
              </tr>
            `).join('')}
          </table>
        </div>`;
    }
  }

  const htmlBody = `
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      margin: 0; padding: 0; background-color: #f4f4f4; line-height: 1.5;
    }
    .email-wrapper { background-color: #f4f4f4; padding: 40px 20px; }
    .container {
      max-width: 800px; margin: 0 auto; background-color: #ffffff;
      border-radius: 12px; overflow: hidden;
      box-shadow: 0 0 30px rgba(0,0,0,0.1); border: 1px solid rgba(0,0,0,0.05);
    }
    .header { background-color: #171717; padding: 25px 30px; color: #ffffff; }
    .header h2 { margin: 0; font-size: 22px; font-weight: 400; }
    .header .timestamp { font-size: 13px; opacity: 0.8; margin-top: 6px; }
    .content { padding: 25px 30px; }
    .footer {
      background-color: #f4f4f4; padding: 20px 30px; text-align: center; border-top: 1px solid #e0e0e0;
    }
    .action-button {
      display: inline-block; background-color: #970c1c; color: #ffffff !important;
      padding: 10px 22px; text-decoration: none; border-radius: 6px;
      font-weight: 500; margin: 6px; font-size: 14px;
    }
    .action-button:visited { color: #ffffff !important; }
    @media screen and (max-width: 600px) {
      .email-wrapper { padding: 20px 10px; }
      .action-button { display: block; margin: 8px 0; }
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="container">
      <div class="header">
        <h2>New Qualification Lead</h2>
        <div class="timestamp">${new Date().toLocaleString()}</div>
      </div>

      <div class="content">
        <!-- Priority Alert -->
        <div style="background-color: ${risk.color}; color: white; padding: 16px; margin: -25px -30px 25px -30px; text-align: center; font-size: 18px; font-weight: bold;">
          ${risk.level} LEAD - ${data.securityScore}%
        </div>

        <!-- Lead Summary -->
        <div style="background-color: #f4f4f4; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
          <h3 style="margin: 0 0 10px 0; font-size: 16px; color: #171717;">Lead Summary</h3>
          <div style="font-size: 14px;">
            <p style="margin: 4px 0;"><strong>Company:</strong> ${data.companyName}</p>
            <p style="margin: 4px 0;"><strong>Contact:</strong> ${data.firstName} ${data.lastName}</p>
            <p style="margin: 4px 0;"><strong>Email:</strong> <a href="mailto:${data.email}" style="color: #970c1c;">${data.email}</a></p>
            <p style="margin: 4px 0;"><strong>Phone:</strong> ${data.phone || 'Not provided'}</p>
            ${data.title ? `<p style="margin: 4px 0;"><strong>Title:</strong> ${data.title}</p>` : ''}
          </div>
        </div>

        ${categoryHtml}
        ${vulnHtml}
        ${orgProfileHtml}
        ${questionsHtml}
      </div>

      <div class="footer">
        <a href="https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}" class="action-button">View in Spreadsheet</a>
        <a href="mailto:${data.email}" class="action-button">Contact Lead</a>
      </div>
    </div>
  </div>
</body>
</html>
  `;

  GmailApp.sendEmail(
    MANAGEMENT_EMAIL,
    subject,
    '',
    {
      htmlBody: htmlBody,
      name: 'RCS Qualification System',
      from: SENDER_EMAIL
    }
  );
}

