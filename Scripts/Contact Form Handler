// QUALIFICATION FORM FUNCTIONS
// =============================================================================

// Vulnerability message mapping for each scored question (Q6-Q29)
const VULNERABILITY_MESSAGES = {
  6: "Infrequent rekeying of door locks and access codes",
  7: "Inadequate visitor sign-in and escort procedures",
  8: "Sensitive areas lack separate access controls",
  9: "Delayed access revocation for departing employees",
  10: "Facility vulnerable to tailgating attacks",
  11: "Insufficient security camera coverage or retention",
  12: "Front desk susceptible to social engineering",
  13: "Weak phone caller verification procedures",
  14: "Insufficient phishing and social engineering testing",
  15: "Uniform-based access vulnerability in restricted areas",
  16: "No clear social engineering response procedure",
  17: "Unknown USB device exposure risk",
  18: "Missing or inadequate incident response plan",
  19: "Incident response plan not recently tested",
  20: "Unclear security incident contact procedures",
  21: "No recent tabletop or simulated security exercises",
  22: "Outdated or absent security awareness training",
  23: "Inconsistent computer locking practices",
  24: "Lacking confidential security reporting mechanism",
  25: "Low employee security awareness and reporting culture",
  26: "Insufficient compliance documentation for physical security",
  27: "No recent physical security compliance audit",
  28: "Inadequate physical access audit logging",
  29: "Low confidence in compliance audit readiness"
};

// Get risk level and color based on security score (higher = better)
function getQualificationRiskInfo(securityScore) {
  if (securityScore <= 40) {
    return {
      level: 'CRITICAL',
      color: '#970c1c',
      message: 'Your organization faces critical security vulnerabilities that require immediate attention.'
    };
  } else if (securityScore <= 60) {
    return {
      level: 'HIGH RISK',
      color: '#970c1c',
      message: 'Your organization has several security vulnerabilities that should be addressed immediately.'
    };
  } else if (securityScore <= 80) {
    return {
      level: 'MODERATE RISK',
      color: '#ffc107',
      message: 'Your organization has some security gaps that need attention to strengthen your posture.'
    };
  } else {
    return {
      level: 'LOW RISK',
      color: '#28a745',
      message: 'Your organization has a strong security posture. Continue maintaining your current controls.'
    };
  }
}

// Get vulnerabilities (questions where user scored poorly)
function getVulnerabilities(questionsAnswered, maxItems) {
  if (!questionsAnswered || !Array.isArray(questionsAnswered)) return [];

  return questionsAnswered
    .filter(qa => qa.scored && qa.points <= 4)
    .sort((a, b) => a.points - b.points) // Worst first
    .slice(0, maxItems || 999)
    .map(qa => VULNERABILITY_MESSAGES[qa.questionId] || qa.question);
}

// Save qualification form data to Google Sheets
function saveQualificationToSpreadsheet(data) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);

  if (!sheet) {
    throw new Error('Sheet not found: ' + SHEET_NAME);
  }

  // Check if headers exist (same format as contact form)
  if (sheet.getLastRow() === 0) {
    const headers = [
      'Timestamp', 'First Name', 'Last Name', 'Phone', 'Email',
      'Company Name', 'Business Email', 'Street Address', 'City',
      'State', 'Country', 'Zip', 'Business Description', 'Employees', 'Services'
    ];
    sheet.appendRow(headers);
  }

  const risk = getQualificationRiskInfo(data.securityScore);

  // Save in same format as contact form - put assessment info in Business Description
  const row = [
    new Date(),
    data.firstName || '',
    data.lastName || '',
    data.phone || '',
    data.email || '',
    data.companyName || '',
    data.email || '', // Business email = same as personal for qualification
    '', '', '', '', '', // Address fields blank
    'Qualification Assessment - ' + data.securityScore + '% ' + risk.level,
    '', // Employees blank
    'Security Assessment'
  ];

  sheet.appendRow(row);
}

// Determine the client's weakest category and return the corresponding PDF as a blob
function getWeakestCategoryGuide(categoryScores) {
  if (!categoryScores || typeof categoryScores !== 'object') return null;

  let lowestScore = Infinity;
  let weakestCategory = null;

  // Iterate in priority order so ties are broken by priority
  GUIDE_PRIORITY.forEach(cat => {
    if (categoryScores[cat] !== undefined && categoryScores[cat] < lowestScore) {
      lowestScore = categoryScores[cat];
      weakestCategory = cat;
    }
  });

  if (!weakestCategory || !GUIDE_FILE_IDS[weakestCategory]) return null;

  try {
    const file = DriveApp.getFileById(GUIDE_FILE_IDS[weakestCategory]);
    return {
      category: weakestCategory,
      score: lowestScore,
      blob: file.getBlob().setName(GUIDE_FILENAMES[weakestCategory])
    };
  } catch (e) {
    console.error('Error fetching guide PDF:', e);
    return null;
  }
}

