// Google Apps Script for RCS Contact Form
// This script handles form submissions, saves to Google Sheets, and sends emails

// Configuration
const SPREADSHEET_ID = '1PxscgTQUlz-UVLHHEaeoWBeDxknDjteMyfid0Oie_N4';
const SHEET_NAME = 'Sheet1'; // Update if your sheet has a different name
const SENDER_EMAIL = 'no-reply@redcellsolutions.com';

// Color configuration for lead age
const LEAD_COLORS = {
  NEW: '#00ff00',        // Green - 10 mins or newer
  RECENT: '#00ffff',     // Cyan - 10-30 mins
  MODERATE: '#ff00ff',   // Magenta - 30-60 mins
  OLD: '#dc143c'         // Red berry - 60+ mins
};

// Management email address
const MANAGEMENT_EMAIL = 'mgmt.rcs@gmail.com';

// Remediation guide PDFs stored in Google Drive
// Priority order for tie-breaking (lower index = higher priority)
const GUIDE_PRIORITY = [
  'Social Engineering Susceptibility',
  'Employee Security Culture',
  'Incident Response Readiness',
  'Physical Access Control',
  'Compliance Alignment'
];

const GUIDE_FILE_IDS = {
  'Physical Access Control': '1xmwRc1nQ3q_OPm3WEAfE52naob35YBXw',
  'Social Engineering Susceptibility': '1pujQ_kL0l3d6plxTJ1QX3J1HDXL-afeS',
  'Incident Response Readiness': '1Sp3fzUGZWBoLVHrkcFP7pVvbXlvnKird',
  'Employee Security Culture': '1enQL-dJ1WOkyHWP4cZ-tYr80Z2qbkYcj',
  'Compliance Alignment': '1X2g3VIbpKJ68vbKrNhw89kLRGDm0cd6r'
};

const GUIDE_FILENAMES = {
  'Physical Access Control': 'Physical_Access_Control_Remediation_Guide.pdf',
  'Social Engineering Susceptibility': 'Social_Engineering_Defense_Remediation_Guide.pdf',
  'Incident Response Readiness': 'Incident_Response_Readiness_Remediation_Guide.pdf',
  'Employee Security Culture': 'Employee_Security_Culture_Remediation_Guide.pdf',
  'Compliance Alignment': 'Compliance_Alignment_Remediation_Guide.pdf'
